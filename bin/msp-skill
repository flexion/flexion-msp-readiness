#!/bin/bash

##
# MSP Readiness Skill Helper
#
# This script makes it easier for Claude Code to invoke the MSP readiness tool
# with better error handling and user guidance.
##

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
REPO_DIR="$(dirname "$SCRIPT_DIR")"

# Function to print colored messages
print_error() { echo -e "${RED}✗ $1${NC}" >&2; }
print_success() { echo -e "${GREEN}✓ $1${NC}"; }
print_info() { echo -e "${BLUE}ℹ $1${NC}"; }
print_warning() { echo -e "${YELLOW}⚠ $1${NC}"; }

# Function to check if tool is built
check_tool_built() {
  if [ ! -f "$REPO_DIR/dist/cli.js" ]; then
    print_error "MSP readiness tool not built"
    print_info "Building tool..."
    cd "$REPO_DIR" && npm run build
    print_success "Build complete"
  fi
}

# Function to check if config exists
check_config() {
  if [ ! -f "config.yaml" ]; then
    print_warning "No config.yaml found in current directory"
    if [ -f "$REPO_DIR/config.example.yaml" ]; then
      print_info "Creating config.yaml from template..."
      cp "$REPO_DIR/config.example.yaml" ./config.yaml
      print_warning "Please edit config.yaml with your project details"
      return 1
    else
      print_error "Could not find config.example.yaml"
      return 1
    fi
  fi
  return 0
}

# Function to check AWS credentials
check_aws_credentials() {
  if ! aws sts get-caller-identity &>/dev/null; then
    print_warning "AWS credentials not configured or invalid"
    print_info "You can either:"
    print_info "  1. Run 'aws configure' to set up credentials"
    print_info "  2. Use '--skip-aws' flag to skip AWS analysis"
    return 1
  fi
  return 0
}

# Main command dispatcher
COMMAND="${1:-assess}"
shift || true

case "$COMMAND" in
  assess)
    print_info "Running MSP readiness assessment..."
    check_tool_built
    if ! check_config; then
      exit 1
    fi

    # Check AWS credentials (but don't fail, suggest --skip-aws)
    if ! check_aws_credentials; then
      print_warning "Proceeding with --skip-aws flag"
      node "$REPO_DIR/dist/cli.js" assess --skip-aws "$@"
    else
      node "$REPO_DIR/dist/cli.js" assess "$@"
    fi

    print_success "Assessment complete!"
    if [ -f "assessment-report.md" ]; then
      print_info "Report saved to: assessment-report.md"
    fi
    ;;

  collect-evidence)
    print_info "Collecting MSP evidence from AWS..."
    check_tool_built
    if ! check_config; then
      exit 1
    fi

    if ! check_aws_credentials; then
      print_error "AWS credentials required for evidence collection"
      exit 1
    fi

    node "$REPO_DIR/dist/cli.js" collect-evidence "$@"
    print_success "Evidence collection complete!"
    ;;

  generate)
    print_info "Generating MSP documentation..."
    check_tool_built
    if ! check_config; then
      exit 1
    fi

    node "$REPO_DIR/dist/cli.js" generate "$@"
    print_success "Documentation generated!"
    ;;

  dashboard)
    print_info "Building MSP dashboard..."
    check_tool_built

    if [ ! -f "assessment-report.json" ]; then
      print_error "No assessment-report.json found"
      print_info "Run 'msp-skill assess' first to generate assessment data"
      exit 1
    fi

    node "$REPO_DIR/dist/cli.js" dashboard "$@"
    print_success "Dashboard built!"
    if [ -f "dashboard.html" ]; then
      print_info "Dashboard saved to: dashboard.html"
      print_info "Open with: open dashboard.html"
    fi
    ;;

  status)
    check_tool_built
    if ! check_config; then
      exit 1
    fi
    node "$REPO_DIR/dist/cli.js" status "$@"
    ;;

  full)
    print_info "Running full MSP readiness workflow..."
    print_info ""
    print_info "Step 1/4: Assessment"
    "$0" assess "$@"
    echo ""

    print_info "Step 2/4: Evidence Collection"
    "$0" collect-evidence "$@"
    echo ""

    print_info "Step 3/4: Generate Documentation"
    "$0" generate "$@"
    echo ""

    print_info "Step 4/4: Build Dashboard"
    "$0" dashboard "$@"
    echo ""

    print_success "Full workflow complete!"
    print_info "Review dashboard.html for results"
    ;;

  help|--help|-h)
    cat <<EOF
MSP Readiness Skill Helper

Usage: msp-skill <command> [options]

Commands:
  assess              Run MSP readiness assessment
  collect-evidence    Collect evidence from AWS services
  generate            Generate missing playbooks and runbooks
  dashboard           Build interactive HTML dashboard
  status              Show current configuration
  full                Run complete workflow (assess + collect + generate + dashboard)
  help                Show this help message

Options:
  --config <path>     Path to config file (default: config.yaml)
  --skip-aws          Skip AWS infrastructure analysis (assess only)
  --output <path>     Output path for reports (assess only)
  --format <format>   Report format: markdown, json, or both (assess only)

Examples:
  msp-skill assess                    # Run assessment with AWS analysis
  msp-skill assess --skip-aws         # Documentation-only assessment
  msp-skill collect-evidence          # Collect AWS evidence
  msp-skill generate                  # Generate missing docs
  msp-skill dashboard                 # Build dashboard
  msp-skill full                      # Run complete workflow

Configuration:
  The tool expects config.yaml in the current directory.
  If not found, a template will be created for you to customize.

AWS Credentials:
  The tool uses AWS SDK default credential chain:
  1. Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
  2. Shared credentials file (~/.aws/credentials)
  3. IAM role (if running on EC2/ECS/Lambda)

For more information, see:
  $REPO_DIR/README.md
  $REPO_DIR/SKILL-USAGE.md
EOF
    ;;

  *)
    print_error "Unknown command: $COMMAND"
    print_info "Run 'msp-skill help' for usage information"
    exit 1
    ;;
esac
