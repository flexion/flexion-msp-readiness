<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{projectName}} - MSP Readiness Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #f5f7fa;
            color: #333;
            line-height: 1.6;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px;
            border-radius: 12px;
            margin-bottom: 30px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        header .subtitle {
            font-size: 1.2em;
            opacity: 0.9;
        }

        .metrics {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .metric-card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            border-left: 4px solid #667eea;
        }

        .metric-card h3 {
            font-size: 0.9em;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .metric-card .value {
            font-size: 2.5em;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
        }

        .metric-card .label {
            color: #999;
            font-size: 0.9em;
        }

        .metric-card.success {
            border-left-color: #48bb78;
        }

        .metric-card.warning {
            border-left-color: #ed8936;
        }

        .metric-card.danger {
            border-left-color: #f56565;
        }

        .section {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            margin-bottom: 30px;
        }

        .section h2 {
            font-size: 1.8em;
            margin-bottom: 20px;
            color: #333;
            border-bottom: 2px solid #667eea;
            padding-bottom: 10px;
        }

        .category-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }

        .category-card {
            padding: 20px;
            background: #f9fafb;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
        }

        .category-card h3 {
            font-size: 1.3em;
            margin-bottom: 15px;
            color: #667eea;
        }

        .progress-bar {
            width: 100%;
            height: 30px;
            background: #e2e8f0;
            border-radius: 15px;
            overflow: hidden;
            margin: 15px 0;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #48bb78, #38a169);
            transition: width 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 0.85em;
        }

        .stats {
            display: flex;
            justify-content: space-between;
            margin-top: 15px;
            font-size: 0.9em;
        }

        .stats span {
            padding: 5px 10px;
            border-radius: 4px;
            background: white;
        }

        .stats .addressed {
            color: #48bb78;
            border: 1px solid #48bb78;
        }

        .stats .partial {
            color: #ed8936;
            border: 1px solid #ed8936;
        }

        .stats .gap {
            color: #f56565;
            border: 1px solid #f56565;
        }

        .requirements-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .requirements-table th {
            background: #f7fafc;
            padding: 12px;
            text-align: left;
            font-weight: 600;
            color: #4a5568;
            border-bottom: 2px solid #e2e8f0;
        }

        .requirements-table td {
            padding: 12px;
            border-bottom: 1px solid #e2e8f0;
        }

        .requirements-table tr:hover {
            background: #f7fafc;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.85em;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-addressed {
            background: #c6f6d5;
            color: #22543d;
        }

        .status-partial {
            background: #feebc8;
            color: #7c2d12;
        }

        .status-gap, .status-not-started {
            background: #fed7d7;
            color: #742a2a;
        }

        .status-not-applicable {
            background: #e2e8f0;
            color: #4a5568;
        }

        .chart-container {
            position: relative;
            height: 400px;
            margin: 20px 0;
        }

        .trend-indicator {
            display: inline-flex;
            align-items: center;
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 600;
            margin: 10px 0;
        }

        .trend-up {
            background: #c6f6d5;
            color: #22543d;
        }

        .trend-down {
            background: #fed7d7;
            color: #742a2a;
        }

        .trend-stable {
            background: #e2e8f0;
            color: #4a5568;
        }

        .info-box {
            background: #ebf8ff;
            border-left: 4px solid #4299e1;
            padding: 15px;
            border-radius: 4px;
            margin: 15px 0;
        }

        .critical-gap {
            background: #fff5f5;
            border-left: 4px solid #f56565;
            padding: 15px;
            margin: 10px 0;
            border-radius: 4px;
        }

        .critical-gap h4 {
            color: #742a2a;
            margin-bottom: 8px;
        }

        .critical-gap .effort {
            color: #c53030;
            font-weight: 600;
        }

        footer {
            text-align: center;
            padding: 30px;
            color: #718096;
            font-size: 0.9em;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>{{projectName}}</h1>
            <div class="subtitle">MSP Readiness Dashboard - Generated {{date}}</div>
        </header>

        <div class="metrics">
            <div class="metric-card success">
                <h3>Overall Completion</h3>
                <div class="value">{{overallPercent}}%</div>
                <div class="label">{{addressed}} of {{total}} requirements</div>
            </div>

            <div class="metric-card success">
                <h3>Addressed</h3>
                <div class="value">{{addressed}}</div>
                <div class="label">Fully compliant</div>
            </div>

            <div class="metric-card warning">
                <h3>Partial</h3>
                <div class="value">{{partial}}</div>
                <div class="label">In progress</div>
            </div>

            <div class="metric-card danger">
                <h3>Gaps</h3>
                <div class="value">{{gap}}</div>
                <div class="label">Need attention</div>
            </div>
        </div>

        {{#if trend.hasTrend}}
        <div class="section">
            <h2>📈 Progress Trend</h2>

            <div class="trend-indicator {{trend.directionClass}}">
                {{trend.directionIcon}} Trend: {{trend.direction}} ({{trend.averageChange}}% per week)
            </div>

            {{#if trend.projectedCompletion}}
            <div class="info-box">
                🎯 Projected 100% completion: <strong>{{trend.projectedCompletion}}</strong>
            </div>
            {{/if}}

            <div class="chart-container">
                <canvas id="trendChart"></canvas>
            </div>

            <div class="chart-container">
                <canvas id="stackedChart"></canvas>
            </div>
        </div>
        {{/if}}

        <div class="section">
            <h2>📊 Progress by Category</h2>
            <div class="category-grid">
                {{#each categories}}
                <div class="category-card">
                    <h3>{{this.name}}</h3>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: {{this.percent}}%">
                            {{this.percent}}%
                        </div>
                    </div>
                    <div class="stats">
                        <span class="addressed">✓ {{this.addressed}}</span>
                        <span class="partial">⚠ {{this.partial}}</span>
                        <span class="gap">✗ {{this.gap}}</span>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        {{#if hasCriticalGaps}}
        <div class="section">
            <h2>🚨 Critical Gaps</h2>
            <p>These high-priority requirements need immediate attention:</p>
            {{#each criticalGaps}}
            <div class="critical-gap">
                <h4>{{this.id}}: {{this.name}}</h4>
                <p>{{this.description}}</p>
                <p><span class="effort">Estimated effort: {{this.effort}} hours</span></p>
            </div>
            {{/each}}
        </div>
        {{/if}}

        <div class="section">
            <h2>📋 All Requirements</h2>
            <table class="requirements-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Requirement</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Effort (hrs)</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each requirements}}
                    <tr>
                        <td><strong>{{this.id}}</strong></td>
                        <td>{{this.name}}</td>
                        <td>{{this.category}}</td>
                        <td><span class="status-badge status-{{this.status}}">{{this.status}}</span></td>
                        <td>{{this.effort}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        <footer>
            Generated by MSP Readiness Automation Tool | Evidence files: {{evidenceCount}}
        </footer>
    </div>

    {{#if trend.hasTrend}}
    <script>
        // Trend Chart
        const trendCtx = document.getElementById('trendChart').getContext('2d');
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: {{{trend.chartLabels}}},
                datasets: [{
                    label: 'Completion %',
                    data: {{{trend.chartData}}},
                    borderColor: '#667eea',
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    tension: 0.4,
                    fill: true,
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: {
                        display: true,
                        text: 'Completion Percentage Over Time',
                        font: { size: 16 }
                    },
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: {
                            callback: function(value) {
                                return value + '%';
                            }
                        }
                    }
                }
            }
        });

        // Stacked Chart
        const stackedCtx = document.getElementById('stackedChart').getContext('2d');
        new Chart(stackedCtx, {
            type: 'bar',
            data: {
                labels: {{{trend.chartLabels}}},
                datasets: [
                    {
                        label: 'Addressed',
                        data: {{{trend.chartAddressed}}},
                        backgroundColor: '#48bb78'
                    },
                    {
                        label: 'Partial',
                        data: {{{trend.chartPartial}}},
                        backgroundColor: '#ed8936'
                    },
                    {
                        label: 'Gaps',
                        data: {{{trend.chartGap}}},
                        backgroundColor: '#f56565'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: {
                        display: true,
                        text: 'Requirements by Status Over Time',
                        font: { size: 16 }
                    },
                    legend: {
                        position: 'bottom'
                    }
                },
                scales: {
                    x: {
                        stacked: true
                    },
                    y: {
                        stacked: true,
                        beginAtZero: true
                    }
                }
            }
        });
    </script>
    {{/if}}
</body>
</html>
