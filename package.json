{
  "name": "flexion-msp-readiness",
  "version": "1.0.0",
  "description": "Automated AWS MSP Program readiness assessment and documentation generation",
  "main": "dist/index.js",
  "bin": {
    "msp-readiness": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run clean && tsc && npm run copy-templates && npm run validate-build",
    "copy-templates": "copyfiles -u 1 \"templates/**/*.{hbs,html}\" dist",
    "validate-build": "node scripts/validate-build.js",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "dev": "ts-node src/cli.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "aws",
    "msp",
    "compliance",
    "cis-controls",
    "automation",
    "claude-code"
  ],
  "author": "Flexion Inc.",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-backup": "^3.1096.0",
    "@aws-sdk/client-cloudtrail": "^3.1096.0",
    "@aws-sdk/client-cloudwatch": "^3.1096.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1096.0",
    "@aws-sdk/client-config-service": "^3.1096.0",
    "@aws-sdk/client-ec2": "^3.1096.0",
    "@aws-sdk/client-iam": "^3.1096.0",
    "@aws-sdk/client-inspector2": "^3.1096.0",
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/client-securityhub": "^3.1096.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "date-fns": "^2.30.0",
    "handlebars": "^4.7.8",
    "inquirer": "^8.2.6",
    "marked": "^9.1.6",
    "ora": "^5.4.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
